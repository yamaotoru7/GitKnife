<Project Sdk="Microsoft.NET.Sdk">

  <!--
    interactive rebase の GIT_SEQUENCE_EDITOR／GIT_EDITOR 役。git-rebase-todo と COMMIT_EDITMSG を
    本体から受け取った内容で書き換える。起動が速いことが大事なので、依存は GitKnife.Core（パッケージ参照なし）だけ。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GitKnife.RI</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitKnife.Core\GitKnife.Core.csproj" />
  </ItemGroup>

</Project>
