<UserControl x:Class="GitKnife.Views.NotificationBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GitKnife.Controls"
             AutomationProperties.AutomationId="NotificationBar"
             DataContext="{Binding Notification}"
             Visibility="{Binding IsVisible, Converter={StaticResource Gk.BoolToVisibility}}">
    <!-- 進行中の操作の帯 -->
    <Border Background="{DynamicResource Gk.Header.Background}" BorderBrush="{DynamicResource Gk.Splitter}" BorderThickness="0,0,0,1" Height="28" Padding="6,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:IconImage AutomationProperties.AutomationId="StatusImage" Geometry="{StaticResource Icon.Warning}" Stroke="{DynamicResource Gk.Change.Modified}" Width="16" Height="16" Margin="0,0,6,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Text" AutomationProperties.AutomationId="NotificationTextBlock" FontSize="13" VerticalAlignment="Center"/>
                <ProgressBar AutomationProperties.AutomationId="RebaseProgressBar" Width="100" Height="5" Margin="12,0,0,0" Value="{Binding Progress}"
                             Visibility="{Binding ShowProgress, Converter={StaticResource Gk.BoolToVisibility}}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button AutomationProperties.AutomationId="Button1" Content="{Binding Button1}" AutomationProperties.Name="{Binding Button1}" Style="{StaticResource Gk.Button}" Margin="0,0,6,0"
                        Visibility="{Binding Button1, Converter={StaticResource Gk.NotEmptyToVisibility}}" Click="Button1_Click"/>
                <Button AutomationProperties.AutomationId="Button2" Content="{Binding Button2}" AutomationProperties.Name="{Binding Button2}" Style="{StaticResource Gk.Button}" Margin="0,0,6,0"
                        Visibility="{Binding Button2, Converter={StaticResource Gk.NotEmptyToVisibility}}" IsEnabled="{Binding Button2Enabled}" Click="Button2_Click"/>
                <Button AutomationProperties.AutomationId="Button3" Content="{Binding Button3}" AutomationProperties.Name="{Binding Button3}" Style="{StaticResource Gk.Button}" Margin="0,0,6,0"
                        Visibility="{Binding Button3, Converter={StaticResource Gk.NotEmptyToVisibility}}" Click="Button3_Click"/>
                <Button AutomationProperties.AutomationId="AbortButton" Content="Abort" Style="{StaticResource Gk.Button}" Click="Abort_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
