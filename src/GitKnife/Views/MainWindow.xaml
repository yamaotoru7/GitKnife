<Window x:Class="GitKnife.Views.MainWindow" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GitKnife.Controls"
        xmlns:v="clr-namespace:GitKnife.Views"
        xmlns:vm="clr-namespace:GitKnife.ViewModels"
        xmlns:local="clr-namespace:GitKnife"
        Title="{Binding Title}" Width="1440" Height="900" MinWidth="800" MinHeight="500"
        Background="{DynamicResource Gk.Window.Background}" Foreground="{DynamicResource Gk.Text}"
        FontFamily="{StaticResource Gk.UiFont}" FontSize="12"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen" Icon="/Assets/GitKnife.ico">
    <!--
      メインウィンドウ。
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="26" ResizeBorderThickness="4" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding RestoreClosedTabCommand}"/>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding SelectNextTabCommand}"/>
        <KeyBinding Gesture="Ctrl+T" Command="{Binding NewTabCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding SelectPreviousTabCommand}"/>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== タイトルバー：メニュー、題名、通知、最小化／最大化／閉じる ===== -->
        <Grid Grid.Row="0" Background="{DynamicResource Gk.TitleBar.Background}">
            <Menu x:Name="MainMenu" AutomationProperties.AutomationId="PART_MainMenu" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"
                  WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="_File">
                    <MenuItem Header="Init New Repository..." Click="InitRepository_Click"/>
                    <MenuItem Header="Clone..." Click="Clone_Click"/>
                    <Separator/>
                    <MenuItem Header="New Tab" InputGestureText="Ctrl+T" Command="{Binding NewTabCommand}"/>
                    <MenuItem Header="Open Repository..." InputGestureText="Ctrl+O" Click="OpenRepository_Click"/>
                    <!-- GitKnife だけ：SSH のホストの上のリポジトリ（T1301） -->
                    <MenuItem Header="Quick Launch..." InputGestureText="Ctrl+P" Click="QuickLaunch_Click"/>
                    <MenuItem Header="Close Tab" InputGestureText="Ctrl+W" Command="{Binding CloseTabCommand}"/>
                    <MenuItem Header="Restore Closed Tab" InputGestureText="Ctrl+Shift+T" Command="{Binding RestoreClosedTabCommand}"/>
                    <Separator/>
                    <MenuItem Header="Configure SSH Keys..." IsEnabled="False"/>
                    <MenuItem Header="Accounts..." IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Header="Check for Updates..." Click="CheckForUpdates_Click"/>
                    <Separator/>
                    <MenuItem Header="Preferences..." InputGestureText="Ctrl+," Click="Preferences_Click"/>
                    <Separator/>
                    <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="Exit_Click"/>
                </MenuItem>
                <MenuItem Header="_View" SubmenuOpened="ViewMenu_SubmenuOpened">
                    <MenuItem Header="Show Uncommitted Changes" Command="{Binding SelectedTab.ShowLocalChangesCommand}"/>
                    <MenuItem Header="Show All Commits" Command="{Binding SelectedTab.ShowAllCommitsCommand}"/>
                    <Separator/>
                    <MenuItem Header="Hide Commit Details" InputGestureText="Ctrl+Shift+D" Click="ToggleDetails_Click"/>
                    <Separator/>
                    <MenuItem Header="Show HEAD" InputGestureText="Ctrl+0" Click="ShowHead_Click"/>
                    <Separator/>
                    <!-- 表示オプション（付いているものはチェック。worktree-config.toml に書く） -->
                    <MenuItem x:Name="HideTagsMenuItem" Header="Hide Tags" Click="HideTags_Click"/>
                    <MenuItem x:Name="HideStashesMenuItem" Header="Hide Stashes in Commit List" Click="HideStashes_Click"/>
                    <MenuItem x:Name="ReflogMenuItem" Header="Show Lost Commits (Reflog)" Click="Reflog_Click"/>
                    <MenuItem x:Name="CollapseMergesMenuItem" Header="Collapse All Merges (Show First Parent)" Click="CollapseMerges_Click"/>
                    <MenuItem x:Name="ActiveBranchFilterMenuItem" Header="Filter by Active Branch" InputGestureText="Ctrl+Shift+A" Click="ActiveBranchFilter_Click"/>
                </MenuItem>
                <MenuItem Header="_Repository">
                    <MenuItem Header="Refresh" InputGestureText="F5" Command="{Binding RefreshCommand}"/>
                    <Separator/>
                    <MenuItem Header="Fetch..." Click="Fetch_Click"/>
                    <MenuItem Header="Pull..." Click="Pull_Click"/>
                    <MenuItem Header="Push..." Click="Push_Click"/>
                    <Separator/>
                    <MenuItem Header="Save Stash..." Click="SaveStash_Click"/>
                    <Separator/>
                    <MenuItem Header="New Branch..." InputGestureText="Ctrl+Shift+B" Click="NewBranch_Click"/>
                    <MenuItem Header="New Tag..." InputGestureText="Ctrl+Shift+G" Click="NewTag_Click"/>
                    <MenuItem Header="New Worktree..." Click="NewWorktree_Click"/>
                    <Separator/>
                    <MenuItem x:Name="GitFlowMenu" Header="Git Flow" SubmenuOpened="GitFlowMenu_SubmenuOpened">
                        <MenuItem Header="Initialize Git Flow..." IsEnabled="False"/>
                    </MenuItem>
                    <MenuItem x:Name="LfsMenu" Header="Git LFS" SubmenuOpened="LfsMenu_SubmenuOpened">
                        <MenuItem Header="Initialize Git LFS" IsEnabled="False"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Apply Patch…" Click="ApplyPatch_Click"/>
                    <Separator/>
                    <MenuItem Header="Bisect" Click="Bisect_Click"/>
                    <Separator/>
                    <MenuItem Header="Open In File Explorer" InputGestureText="Ctrl+Alt+O" Click="OpenInExplorer_Click"/>
                    <MenuItem Header="Open In Console" InputGestureText="Ctrl+Alt+C" Click="OpenInConsole_Click"/>
                    <Separator/>
                    <MenuItem Header="Repository Statistics..." IsEnabled="False"/>
                    <MenuItem Header="Repository Treemap..." IsEnabled="False"/>
                    <MenuItem Header="Performance Benchmark..." IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Header="Settings for This Repository..." Click="RepositorySettings_Click"/>
                </MenuItem>
                <MenuItem Header="_Window">
                    <MenuItem Header="Select Previous Tab" InputGestureText="Ctrl+Shift+Tab" Command="{Binding SelectPreviousTabCommand}"/>
                    <MenuItem Header="Select Next Tab" InputGestureText="Ctrl+Tab" Command="{Binding SelectNextTabCommand}"/>
                    <Separator/>
                    <MenuItem Header="Switch Theme" Click="SwitchTheme_Click"/>
                    <Separator/>
                    <MenuItem Header="Zoom In" InputGestureText="Ctrl+=" Click="ZoomIn_Click"/>
                    <MenuItem Header="Zoom Out" InputGestureText="Ctrl+-" Click="ZoomOut_Click"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="Keyboard Shortcuts" IsEnabled="False"/>
                    <MenuItem Header="Release Notes" IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Header="About GitKnife" Click="About_Click"/>
                </MenuItem>
            </Menu>

            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Gk.Text}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button AutomationProperties.AutomationId="Part_NotificationManagerToggleButton" Style="{StaticResource Gk.CaptionButton}" Width="30" ToolTip="Notifications (not available yet)"
                        IsEnabled="False" ToolTipService.ShowOnDisabled="True">
                    <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Bell}"/>
                </Button>
                <Button AutomationProperties.AutomationId="FeedbackButton" Style="{StaticResource Gk.CaptionButton}" Width="30" ToolTip="Feedback (Ctrl+Shift+F12)" Click="Feedback_Click">
                    <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Smile}"/>
                </Button>
                <Button x:Name="MinimizeButton" AutomationProperties.AutomationId="PART_MinimizeButton" Style="{StaticResource Gk.CaptionButton}" Click="Minimize_Click">
                    <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Minimize}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="RestoreButton" AutomationProperties.AutomationId="PART_RestoreButton" Style="{StaticResource Gk.CaptionButton}" Click="MaximizeRestore_Click">
                    <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Restore}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="MaximizeButton" AutomationProperties.AutomationId="PART_MaximizeButton" Style="{StaticResource Gk.CaptionButton}" Click="MaximizeRestore_Click">
                    <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Maximize}" StrokeThickness="1"/>
                </Button>
                <Button AutomationProperties.AutomationId="PART_CloseButton" Style="{StaticResource Gk.CloseCaptionButton}" Click="Close_Click">
                    <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Close}" StrokeThickness="1"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== ツールバー ===== -->
        <Grid Grid.Row="1" Background="{DynamicResource Gk.Toolbar.Background}" AutomationProperties.AutomationId="Toolbar">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="6,0,0,0">
                <c:ToolbarButton AutomationProperties.AutomationId="ToggleTabListSidebarToolbarButton" Icon="{StaticResource Icon.TabList}" MinWidth="30" ToolTip="Tab list" Click="ToggleTabList_Click"/>
                <c:ToolbarButton AutomationProperties.AutomationId="OpenQuicklyToolbarButton" Icon="{StaticResource Icon.QuickLaunch}" Label="Quick Launch" Margin="4,3,10,3" Click="QuickLaunch_Click"/>
                <c:ToolbarButton AutomationProperties.AutomationId="FetchToolbarButton" Icon="{StaticResource Icon.Fetch}" Label="Fetch" Click="Fetch_Click"/>
                <c:ToolbarButton AutomationProperties.AutomationId="PullToolbarButton" Icon="{StaticResource Icon.Pull}" Label="Pull" Click="Pull_Click"
                                 Badge="{Binding SelectedTab.BehindCount}" BadgeAutomationId="PullBadgeText"/>
                <c:ToolbarButton AutomationProperties.AutomationId="PushToolbarButton" Icon="{StaticResource Icon.Push}" Label="Push" Click="Push_Click"
                                 Badge="{Binding SelectedTab.AheadCount}" BadgeAutomationId="PushBadgeText"/>
                <c:ToolbarButton x:Name="StashButton" AutomationProperties.AutomationId="StashToolbarButton" Icon="{StaticResource Icon.Stash}" Label="Stash" Margin="10,3,0,3" Click="SaveStash_Click"/>
                <c:DropDownArrowButton AutomationProperties.AutomationId="StashToolbarDropdownButton" Tag="{Binding ElementName=StashButton}" Click="StashDropdown_Click"/>
            </StackPanel>

            <!-- ステータス：リポジトリ名と現在のブランチ、実行中の操作 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="300" Height="36" CornerRadius="4" Background="{DynamicResource Gk.StatusBox.Background}" Margin="0,0,10,0">
                    <Grid>
                        <!-- ジョブの間は 1 行目がジョブ名、2 行目が "Pulling..." や結果（SelectedTab.StatusLine1 / 2）。切り替わると上へずれる（StatusContent_Changed） -->
                        <StackPanel x:Name="StatusContent" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ProgressBar Width="12" Height="12" IsIndeterminate="True" Margin="0,0,5,0" VerticalAlignment="Center"
                                             Visibility="{Binding SelectedTab.IsStatusJobRunning, Converter={StaticResource Gk.BoolToVisibility}}"/>
                                <TextBlock AutomationProperties.AutomationId="TitleTextBlock" Text="{Binding SelectedTab.StatusLine1, NotifyOnTargetUpdated=True}" Binding.TargetUpdated="StatusContent_Changed" Cursor="Hand" MouseLeftButtonUp="StatusTitle_MouseLeftButtonUp" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path AutomationProperties.AutomationId="DescriptionIcon" Data="{StaticResource Icon.Branch}" Visibility="{Binding SelectedTab.ShowBranchIcon, Converter={StaticResource Gk.BoolToVisibility}}" Stroke="{DynamicResource Gk.Text.Dim}" StrokeThickness="1.2"
                                      Width="16" Height="16" RenderTransformOrigin="0.5,0.5" Margin="0,0,1,0">
                                    <Path.RenderTransform><ScaleTransform ScaleX="0.75" ScaleY="0.75"/></Path.RenderTransform>
                                </Path>
                                <TextBlock AutomationProperties.AutomationId="DescriptionTextBlock" Text="{Binding SelectedTab.StatusLine2}" FontSize="11" Foreground="{DynamicResource Gk.Text.Dim}"/>
                            </StackPanel>
                        </StackPanel>
                        <ProgressBar AutomationProperties.AutomationId="BusyIndicator" Width="14" Height="14" IsIndeterminate="True" HorizontalAlignment="Left" Margin="10,0,0,0"
                                     Visibility="{Binding SelectedTab.IsBusy, Converter={StaticResource Gk.BoolToVisibility}}"/>
                        <!-- 動いているジョブを止める（ふだんは出ない） -->
                        <Button AutomationProperties.AutomationId="CancelButton" Style="{StaticResource Gk.HeaderIconButton}" Width="16" Height="16" HorizontalAlignment="Right" Margin="0,0,6,0"
                                ToolTip="Cancel" Click="CancelJob_Click" Visibility="{Binding SelectedTab.IsStatusJobRunning, Converter={StaticResource Gk.BoolToVisibility}}">
                            <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Close}" Width="10" Height="10"/>
                        </Button>
                        <!-- 下端 3px の進捗：実行中は git の割合（まだ無ければ短いバー）、終わったらいっぱいにして約 3 秒 -->
                        <ProgressBar AutomationProperties.AutomationId="StatusProgressBar" Height="3" VerticalAlignment="Bottom" BorderThickness="0" Maximum="100"
                                     Value="{Binding SelectedTab.StatusPercent, Mode=OneWay}"
                                     Background="Transparent" Foreground="{DynamicResource Gk.Accent}"
                                     Visibility="{Binding SelectedTab.ShowsStatusJob, Converter={StaticResource Gk.BoolToVisibility}}"/>
                        <!-- Activity Manager を開く（左下の小さなボタン） -->
                        <Button x:Name="ActivityButton" AutomationProperties.AutomationId="ShowActivityManagerToggleButton" Style="{StaticResource Gk.HeaderIconButton}"
                                Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2,0,0,2" Click="ShowActivity_Click">
                            <c:IconImage Geometry="{StaticResource Icon.Activity}" Width="12" Height="12"/>
                        </Button>
                    </Grid>
                </Border>
                <c:ToolbarButton x:Name="BranchButton" AutomationProperties.AutomationId="BranchToolbarButton" Icon="{StaticResource Icon.NewBranch}" Label="Branch" Click="NewBranch_Click"/>
                <c:DropDownArrowButton AutomationProperties.AutomationId="BranchToolbarDropdownButton" Tag="{Binding ElementName=BranchButton}" Click="BranchDropdown_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                <c:ToolbarButton AutomationProperties.AutomationId="OpenInDropDownButton" Icon="{StaticResource Icon.OpenIn}" Label="Open in" Click="OpenInDropdown_Click"/>
                <c:ToolbarButton AutomationProperties.AutomationId="OpenInConsoleToolbarButton" Icon="{StaticResource Icon.Console}" Label="Console" Click="OpenInConsole_Click"/>
                <c:ToolbarButton AutomationProperties.AutomationId="AppearanceToolbarDropdownButton" Icon="{StaticResource Icon.Appearance}" Label="Appearance" Click="AppearanceDropdown_Click"/>
                <c:ToolbarButton AutomationProperties.AutomationId="WorkspacesToolbarDropdownButton" Icon="{StaticResource Icon.Workspaces}" Label="{Binding ActiveWorkspace}" Click="WorkspacesDropdown_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== タブ。タブ＝リポジトリ、等幅で横いっぱいに並べる ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TabListColumn" Width="0" MinWidth="0"/>
                <ColumnDefinition x:Name="TabListSplitterColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 縦タブ（A04、TabListSidebar）：今のワークスペース名の下にタブ。ToggleTabListSidebarToolbarButton で開閉 -->
            <UserControl x:Name="TabListSidebar" AutomationProperties.AutomationId="TabListSidebar" Visibility="Collapsed" Background="{DynamicResource Gk.Sidebar.Background}">
                <ListBox x:Name="WorkspaceTreeView" AutomationProperties.AutomationId="WorkspaceTreeView" Style="{StaticResource Gk.ListBox}" ItemContainerStyle="{StaticResource Gk.SidebarRow}"
                         SelectionChanged="WorkspaceTreeView_SelectionChanged" ContextMenuOpening="WorkspaceTreeView_ContextMenuOpening" Padding="0,4,0,0">
                    <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
                    <ListBox.Resources>
                        <!-- どの行にも ExpandCollapseToggleButton を置くが、ワークスペースが 1 つのときは見えない -->
                        <DataTemplate DataType="{x:Type vm:TabListWorkspaceNode}">
                            <Grid>
                                <Button AutomationProperties.AutomationId="ExpandCollapseToggleButton" Visibility="Hidden" Width="12" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Margin="20,3,8,3"/>
                            </Grid>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:TabListTabNode}">
                            <Grid Height="22" Background="Transparent" x:Name="Row">
                                <Button AutomationProperties.AutomationId="ExpandCollapseToggleButton" Visibility="Hidden" Width="12" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                <Ellipse Width="6" Height="6" HorizontalAlignment="Left" Margin="24,0,0,0" Fill="{Binding Tab.TabColor, Converter={x:Static local:TabColorBrushConverter.Instance}}"
                                         Visibility="{Binding Tab.ShowTabDot, Converter={StaticResource Gk.BoolToVisibility}}"/>
                                <TextBlock Text="{Binding Tab.Name}" Margin="38,0,24,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="CloseButton" AutomationProperties.AutomationId="CloseButton" Style="{StaticResource Gk.FlatButton}" HorizontalAlignment="Right" Width="18" Height="18" Margin="0,0,4,0"
                                        Padding="0" Opacity="0" Click="TabListClose_Click" ToolTip="Close Tab">
                                    <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Close}" Width="10" Height="10"/>
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseButton" Property="Opacity" Value="1"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.Resources>
                </ListBox>
            </UserControl>
            <GridSplitter x:Name="TabListSplitter" Grid.Column="1" AutomationProperties.AutomationId="TabListSidebarSplitter" Width="1" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Gk.Splitter}" Visibility="Collapsed" DragCompleted="TabListSplitter_DragCompleted"/>

            <Grid Grid.Column="2">
            <TabControl x:Name="Tabs" AutomationProperties.AutomationId="TabControl" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                        PreviewMouseMove="Tabs_PreviewMouseMove" PreviewMouseLeftButtonUp="Tabs_PreviewMouseLeftButtonUp" LostMouseCapture="Tabs_LostMouseCapture"
                        Background="Transparent" BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}" Foreground="{DynamicResource Gk.Text}">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Background="{DynamicResource Gk.TabBar.Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <UniformGrid Rows="1" IsItemsHost="True"/>
                                <Button Grid.Column="1" Style="{StaticResource Gk.FlatButton}" Padding="0" ToolTip="New Tab" Click="OpenRepository_Click">
                                    <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Plus}"/>
                                </Button>
                            </Grid>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding TabName}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Gk.Text.Dim}"/>
                        <Setter Property="ToolTip" Value="{Binding Path}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="Bd" Background="Transparent" Height="24" BorderBrush="{DynamicResource Gk.Window.Background}" BorderThickness="0,0,1,0">
                                        <Grid>
                                            <!-- 未コミットの変更の点。タブに色を付けるとその色 -->
                                            <Ellipse Width="6" Height="6" Fill="{Binding TabColor, Converter={x:Static local:TabColorBrushConverter.Instance}}" HorizontalAlignment="Left" Margin="10,0,0,0"
                                                     Visibility="{Binding ShowTabDot, Converter={StaticResource Gk.BoolToVisibility}}"/>
                                            <TextBlock Text="{Binding TabName}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="22,0"
                                                       Visibility="{Binding IsRenaming, Converter={StaticResource Gk.BoolToVisibility}, ConverterParameter=invert}"/>
                                            <!-- Rename（見出しがその場で入力欄になる。Enter で決定、Esc でやめる） -->
                                            <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Gk.TextBox}" HorizontalAlignment="Center" MinWidth="60" Height="22"
                                                     Visibility="{Binding IsRenaming, Converter={StaticResource Gk.BoolToVisibility}}"
                                                     IsVisibleChanged="RenameBox_IsVisibleChanged" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus"/>
                                            <Button x:Name="CloseButton" AutomationProperties.AutomationId="PART_Close" Style="{StaticResource Gk.FlatButton}" HorizontalAlignment="Right" Margin="0,0,4,0"
                                                    Width="18" Height="18" Padding="0" Visibility="Hidden"
                                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                <Path Data="{StaticResource Icon.Close}" Stroke="{DynamicResource Gk.Text.Dim}" StrokeThickness="1.2" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7"/></Path.RenderTransform>
                                                </Path>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Gk.Tab.Hover}"/>
                                            <Setter TargetName="CloseButton" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Gk.Tab.Active}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Gk.Text}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="PreviewMouseDown" Handler="TabItem_PreviewMouseDown"/>
                        <EventSetter Event="ContextMenuOpening" Handler="TabItem_ContextMenuOpening"/>
                        <Setter Property="ContextMenu"><Setter.Value><ContextMenu/></Setter.Value></Setter>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:RepositoryViewModel}">
                        <!-- Repository Manager のタブ（IsManager）だけ中身が違う -->
                        <ContentControl Content="{Binding}" Focusable="False">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate><v:RepositoryView AutomationProperties.AutomationId="RepositoryUserControl"/></DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManager}" Value="True">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate><v:RepositoryManagerView/></DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- タブがないとき -->
            <TextBlock Text="Open a repository with File &gt; Open Repository... (Ctrl+O)" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Gk.Text.Dim}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tabs.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </Grid>
        </Grid>

        <!-- Activity Manager（ShowActivityManagerToggleButton で開く。ツールバーの下、左端） -->
        <Popup x:Name="ActivityPopup" PlacementTarget="{Binding ElementName=RootGrid}" Placement="Relative" VerticalOffset="60" StaysOpen="False"
               AllowsTransparency="False" PopupAnimation="None" Closed="ActivityPopup_Closed">
            <v:ActivityManagerView x:Name="ActivityView"/>
        </Popup>
    </Grid>
</Window>
