<UserControl x:Class="GitKnife.Views.Dialogs.PullDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GitKnife.Controls">
    <!-- Pull：Remote（RemotesComboBox）、Branch（toggleButton）、Into、RebaseCheckBox、StashAndReapplyCheckBox -->
    <!-- 題名の位置から（アイコンの列 64 + 間 16）。ラベルの列は中身に合わせる（Form と同じ） -->
    <Grid Margin="80,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="26"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Remote:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox Grid.Column="1" AutomationProperties.AutomationId="RemotesComboBox" ItemsSource="{Binding Remotes}" SelectedItem="{Binding SelectedRemote}" ItemTemplate="{StaticResource Gk.RemoteItemTemplate}"/>
        <TextBlock Grid.Row="1" Text="Branch:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <c:RefPicker Grid.Row="1" Grid.Column="1" Items="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" Icon="{StaticResource Icon.Branch}"/>
        <TextBlock Grid.Row="2" Text="Into:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
            <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Branch}" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Into}" VerticalAlignment="Center"/>
        </StackPanel>
        <CheckBox Grid.Row="3" Grid.Column="1" AutomationProperties.AutomationId="RebaseCheckBox" Content="Rebase instead of merge" IsChecked="{Binding Rebase}" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="4" Grid.Column="1" AutomationProperties.AutomationId="StashAndReapplyCheckBox" Content="Stash and reapply local changes" IsChecked="{Binding StashAndReapply}" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
