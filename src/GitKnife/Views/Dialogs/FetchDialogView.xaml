<UserControl x:Class="GitKnife.Views.Dialogs.FetchDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fetch：Remote（RemoteComboBox。Fetch all のときは無効）、FetchAllRemotesCheckBox -->
    <!-- 題名の位置から（アイコンの列 64 + 間 16）。ラベルの列は中身に合わせる（Form と同じ） -->
    <Grid Margin="80,0,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Remote:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox Grid.Column="1" AutomationProperties.AutomationId="RemoteComboBox" ItemsSource="{Binding Remotes}" SelectedItem="{Binding SelectedRemote}" ItemTemplate="{StaticResource Gk.RemoteItemTemplate}"
                  IsEnabled="{Binding FetchAll, Converter={x:Static local:InvertBoolConverter.Instance}}" xmlns:local="clr-namespace:GitKnife"/>
        <CheckBox Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="FetchAllRemotesCheckBox" Content="Fetch all remotes" IsChecked="{Binding FetchAll}" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
