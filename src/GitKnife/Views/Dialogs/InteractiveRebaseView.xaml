<UserControl x:Class="GitKnife.Views.Dialogs.InteractiveRebaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GitKnife.Controls"
             xmlns:v="clr-namespace:GitKnife.Views"
             xmlns:vm="clr-namespace:GitKnife.ViewModels"
             Height="644">
    <!--
      Interactive Rebase。見出し、Rebase / On、UpdateRefsCheckBox、
      コミットの表（RevisionListView。ActionsComboBox、squash の線、SubjectTextBlock、アバター、AuthorTextBlock、AbbreviatedShaTextBlock、AuthorDateTextBlock）、
      下に選んだコミットの詳細（RevisionDetailsView。Commit / Changes、File Tree は押せない）、"Backup current state with a temporary branch"。
      位置と大きさ：一覧は左右 21、上 83、行 22。詳細は 291。
      Reword を選ぶと行の下に件名・Description・Cancel / OK の小さな窓。窓が出ている間はその行が太字。
    -->
    <UserControl.Resources>
        <!-- 動作の点（Squash / Fixup はテーマの色） -->
        <DataTemplate x:Key="ActionDot" DataType="{x:Type vm:RebaseActionItem}">
            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{Binding Color}" VerticalAlignment="Center"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMeld}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Gk.Rebase.Squash}"/></DataTrigger>
                <DataTrigger Binding="{Binding IsMove}" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Collapsed"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ドロップダウンの行：点・名前・説明・キー（Move Up / Down は点なしで名前が左に寄り、キーは "Ctrl+" と色の付いた矢印） -->
        <DataTemplate x:Key="ActionMenuItem" DataType="{x:Type vm:RebaseActionItem}">
            <Grid Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ActionDot}" HorizontalAlignment="Left"/>
                <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding Description}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="34">
                    <TextBlock x:Name="Ctrl" Text="Ctrl+ " Visibility="Collapsed"/>
                    <TextBlock x:Name="Key" Text="{Binding Key}"/>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMove}" Value="True">
                    <Setter TargetName="Name" Property="Grid.Column" Value="0"/>
                    <Setter TargetName="Name" Property="Grid.ColumnSpan" Value="3"/>
                    <Setter TargetName="Ctrl" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Key" Property="Foreground" Value="{DynamicResource Gk.Rebase.MoveArrow}"/>
                    <Setter TargetName="Key" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="ActionMenuItemContainer" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Gk.Text}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Margin="4,0" Padding="13,0,10,0">
                            <Grid>
                                <Border x:Name="Mark" Width="3" CornerRadius="1.5" Background="{DynamicResource Gk.Accent}" HorizontalAlignment="Left" Margin="-12,5,0,5" Visibility="Collapsed"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Gk.Rebase.PopupHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行の動作の欄：枠なしで点・名前・山形。ホバーで地が付く。ドロップダウンは右端をそろえて左へ広がる -->
        <Style x:Key="ActionComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Gk.Text}"/>
            <Setter Property="Width" Value="85"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ActionMenuItemContainer}"/>
            <Setter Property="ItemTemplate" Value="{StaticResource ActionMenuItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                                            <Path Style="{StaticResource Gk.SmallIcon}" Data="{StaticResource Icon.ChevronDown}" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Gk.Rebase.ActionHover}"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Gk.Rebase.ActionHover}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <StackPanel Orientation="Horizontal" Margin="4,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center">
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{StaticResource ActionDot}" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding SelectionBoxItem.Name, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Custom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                                   Loaded="ActionsPopup_Loaded">
                                <Border Background="{DynamicResource Gk.Rebase.Popup}" BorderBrush="{DynamicResource Gk.Splitter}" BorderThickness="1" CornerRadius="4" Padding="0,3"
                                        TextElement.Foreground="{DynamicResource Gk.Text}">
                                    <StackPanel IsItemsHost="True"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 行：高さ 22、角の丸い選択（窓が手前なら青、そうでなければ灰色） -->
        <Style x:Key="RowStyle" TargetType="ListViewItem">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Gk.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" SnapsToDevicePixels="True">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Gk.List.Hover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Gk.CommitList.Selection.Inactive}"/></Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Gk.Selection}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Gk.Text.OnSelection}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 件名・作者・SHA・日付の文字：Squash / Fixup は少し薄く、Drop は取り消し線 -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMeld}" Value="True"><Setter Property="Opacity" Value="0.86"/></DataTrigger>
                <DataTrigger Binding="{Binding IsDrop}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/></DataTrigger>
                <DataTrigger Binding="{Binding IsRewording}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="-20,-26,-20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="291"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Interactive Rebase" FontSize="18" FontWeight="SemiBold" Margin="25,32,0,0" Height="24"/>
        <Grid Grid.Row="1" Margin="25,6,25,8" Height="18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Rebase:" VerticalAlignment="Center" Margin="0,0,13,0"/>
                <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Branch}" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Branch}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="352,0,0,0">
                <TextBlock Text="On:" VerticalAlignment="Center" Margin="0,0,13,0"/>
                <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Commit}" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Base.ShortSha}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding Base.Subject}" VerticalAlignment="Center"/>
                <CheckBox AutomationProperties.AutomationId="UpdateRefsCheckBox" Content="Update dependent branches" IsChecked="{Binding UpdateRefs}" Margin="30,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <ListView Grid.Row="2" x:Name="List" AutomationProperties.AutomationId="RevisionListView" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}"
                  SelectionMode="Extended" Margin="21,0" Background="{DynamicResource Gk.List.Background}" BorderThickness="0" Foreground="{DynamicResource Gk.Text}" Padding="4,4"
                  ItemContainerStyle="{StaticResource RowStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="List_PreviewKeyDown" SelectionChanged="List_SelectionChanged"
                  PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove" AllowDrop="True" DragOver="List_DragOver" Drop="List_Drop">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource Gk.HiddenColumnHeader}">
                    <GridViewColumn Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox AutomationProperties.AutomationId="ActionsComboBox" Style="{StaticResource ActionComboBox}"
                                          ItemsSource="{Binding DataContext.Actions, RelativeSource={RelativeSource AncestorType=ListView}}" SelectedItem="{Binding MenuSelection}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!-- squash の線：Squash / Fixup の行は点と下への線、間の Drop は通る線、入る先は上からの線が曲がって件名を指す矢印 -->
                    <GridViewColumn Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Canvas Width="28" Height="22">
                                    <Line x:Name="Top" X1="16" Y1="-1" X2="16" Y2="11" Stroke="{DynamicResource Gk.Rebase.Graph}" StrokeThickness="1" Visibility="Collapsed"/>
                                    <Line x:Name="Bottom" X1="16" Y1="11" X2="16" Y2="23" Stroke="{DynamicResource Gk.Rebase.Graph}" StrokeThickness="1" Visibility="Collapsed"/>
                                    <Ellipse x:Name="Dot" Canvas.Left="13" Canvas.Top="8" Width="6" Height="6" Fill="{DynamicResource Gk.Rebase.Graph}" Visibility="Collapsed"/>
                                    <Path x:Name="Arrow" Data="M16,-1 L16,5 Q16,11 22,11 L26,11" Stroke="{DynamicResource Gk.Rebase.Graph}" StrokeThickness="1" Visibility="Collapsed"/>
                                    <Path x:Name="Head" Data="M25,7.5 L32,11 L25,14.5 Z" Fill="{DynamicResource Gk.Rebase.Graph}" Visibility="Collapsed"/>
                                </Canvas>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding GraphKind}" Value="Source">
                                        <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Bottom" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GraphKind}" Value="Through">
                                        <Setter TargetName="Bottom" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GraphKind}" Value="Target">
                                        <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Head" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GraphTop}" Value="True">
                                        <Setter TargetName="Top" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="487">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock AutomationProperties.AutomationId="SubjectTextBlock" Text="{Binding Subject}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="19">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <c:Avatar Width="16" Height="16" NameText="{Binding Commit.AuthorName}" Email="{Binding Commit.AuthorEmail}" Margin="-4,0,-5,0"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock AutomationProperties.AutomationId="AuthorTextBlock" Text="{Binding Commit.AuthorName}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock AutomationProperties.AutomationId="AbbreviatedShaTextBlock" Text="{Binding Commit.ShortSha, Mode=OneWay}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock AutomationProperties.AutomationId="AuthorDateTextBlock" Text="{Binding DateText, Mode=OneWay}" Style="{StaticResource CellText}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 選んだコミットの詳細（別ウィンドウと同じ RevisionDetailsView。この ViewModel が IRevisionDetailsHost） -->
        <v:RevisionDetailsView Grid.Row="3" IsEmbedded="True" Margin="21,0"/>

        <!-- Reword のメッセージの編集（一覧の上に重ね、その行の下に出す。位置は開くときにコードで決める）。本文は等幅で 72 桁目に縦線 -->
        <Canvas Grid.Row="2" Margin="21,0" x:Name="RewordLayer" Visibility="{Binding IsRewordOpen, Converter={StaticResource Gk.BoolToVisibility}}" IsVisibleChanged="RewordLayer_IsVisibleChanged">
            <Border x:Name="RewordEditor" Width="621" Padding="10,10,10,7" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Gk.Rebase.Popup}" Background="{DynamicResource Gk.Dialog.Background}">
                <StackPanel>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource Gk.Dialog.Input.Border}" Background="{DynamicResource Gk.Dialog.Input.Background}" CornerRadius="3">
                        <StackPanel>
                            <Grid Height="23">
                                <TextBox x:Name="RewordSubjectBox" AutomationProperties.AutomationId="CommitSubjectTextBox" Text="{Binding RewordSubject, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource Gk.TextBox}" Background="Transparent" BorderThickness="0" FontWeight="Bold" Padding="4,0,40,0"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock AutomationProperties.AutomationId="SubjectLengthLimitTextBlock" Text="{Binding RewordSubjectLength}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,7,0" Foreground="{DynamicResource Gk.Text.Faint}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Gk.Dialog.Input.Border}"/>
                            <Grid>
                                <Border x:Name="RewordRuler" Width="1" HorizontalAlignment="Left" Background="{DynamicResource Gk.Rebase.Ruler}"/>
                                <TextBox x:Name="RewordDescriptionBox" AutomationProperties.AutomationId="CommitDescriptionTextBox" Text="{Binding RewordDescription, UpdateSourceTrigger=PropertyChanged}"
                                         c:TextBoxHint.Placeholder="Description" Style="{StaticResource Gk.TextBox}" Background="Transparent" BorderThickness="0" Height="92" AcceptsReturn="True"
                                         FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button AutomationProperties.AutomationId="RewordCancelButton" Content="Cancel" Style="{StaticResource Gk.Button}" Command="{Binding CancelRewordCommand}" Margin="0,0,7,0"/>
                        <Button AutomationProperties.AutomationId="RewordOkButton" Content="OK" Style="{StaticResource Gk.Button}" Command="{Binding OkRewordCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- フッターの左。GitKnife の注意文（一番古い行は squash にできない など）が出ている間は重ならないよう隠す -->
        <CheckBox Grid.Row="4" AutomationProperties.AutomationId="BackupCheckBox" Content="Backup current state with a temporary branch" IsChecked="{Binding Backup}"
                  Margin="21,15,0,-38" HorizontalAlignment="Left" Visibility="{Binding StatusMessage, Converter={StaticResource Gk.EmptyToVisibility}}"/>
    </Grid>
</UserControl>
