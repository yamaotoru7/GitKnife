<UserControl x:Class="GitKnife.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GitKnife.Controls"
             xmlns:vm="clr-namespace:GitKnife.ViewModels"
             xmlns:local="clr-namespace:GitKnife"
             Background="{DynamicResource Gk.Sidebar.Background}">
    <!-- サイドバー -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- リポジトリ名と設定 -->
        <Grid Grid.Row="0" Height="26" Margin="0,2,0,0">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Button AutomationProperties.AutomationId="RepositorySettingsDropdownButton" Style="{StaticResource Gk.FlatButton}" HorizontalAlignment="Right" Margin="0,0,6,0" Padding="2"
                    Click="RepositorySettings_Click">
                <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Gear}"/>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Rename Repository" Click="RenameRepository_Click"/>
                        <MenuItem Header="Copy Repository Path" Click="CopyRepositoryPath_Click"/>
                        <Separator/>
                        <MenuItem Header="Settings for This Repository..." Click="OpenRepositorySettings_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- Local Changes / All Commits -->
        <StackPanel Grid.Row="1" Margin="0,0,0,6">
            <RadioButton AutomationProperties.AutomationId="ChangesRadioButton" Style="{StaticResource Gk.SidebarViewRadio}" GroupName="View"
                         IsChecked="{Binding View, Converter={StaticResource Gk.EnumEquals}, ConverterParameter=LocalChanges}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.LocalChanges}" Margin="0,0,6,0"/>
                    <TextBlock AutomationProperties.AutomationId="ChangesTextBlock" Text="{Binding LocalChangesText}" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
            <RadioButton AutomationProperties.AutomationId="AllCommitsRadioButton" Style="{StaticResource Gk.SidebarViewRadio}" GroupName="View"
                         IsChecked="{Binding View, Converter={StaticResource Gk.EnumEquals}, ConverterParameter=AllCommits}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.AllCommits}" Margin="0,0,6,0"/>
                    <TextBlock Text="All Commits" VerticalAlignment="Center"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- Branches / Search / Service -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Gk.Border}" BorderThickness="0,1,0,0" Padding="0,2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton AutomationProperties.AutomationId="BranchesRadioButton" Style="{StaticResource Gk.IconRadio}" GroupName="SidebarTab" ToolTip="Branches"
                             IsChecked="{Binding SidebarTab, Converter={StaticResource Gk.EnumEquals}, ConverterParameter=Branches}">
                    <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Branch}"/>
                </RadioButton>
                <RadioButton AutomationProperties.AutomationId="SearchRadioButton" Style="{StaticResource Gk.IconRadio}" GroupName="SidebarTab" ToolTip="Search"
                             IsChecked="{Binding SidebarTab, Converter={StaticResource Gk.EnumEquals}, ConverterParameter=Search}">
                    <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Search}"/>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Search タブ（D13） -->
        <!-- UserControl で包む（Grid は UIA に出ない） -->
        <UserControl Grid.Row="3" Grid.RowSpan="2" AutomationProperties.AutomationId="SearchTabItem" DataContext="{Binding Search}" IsVisibleChanged="SearchTab_IsVisibleChanged">
            <UserControl.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.SidebarTab, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Search">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </UserControl.Style>
        <Grid x:Name="SearchPane">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Search Commits" FontWeight="SemiBold" FontSize="13" Margin="10,2,6,4"/>
            <Grid Grid.Row="1" Margin="6,0,6,3">
                <!-- 文字は左の虫眼鏡の右から（Gk.TextBox は Padding が 2 重に効くので半分）。空のときは "Commit message" など -->
                <TextBox x:Name="SearchBox" AutomationProperties.AutomationId="FilterTextBox" Style="{StaticResource Gk.TextBox}" Height="22" Padding="14,0,10,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown" c:TextBoxHint.Placeholder="{Binding Placeholder}"/>
                <Button AutomationProperties.AutomationId="PART_DropDownButton" Style="{StaticResource Gk.FlatButton}" HorizontalAlignment="Left" Width="28" Height="20" Margin="1,0,0,0" Padding="0"
                        Focusable="False" Click="RecentSearches_Click" ToolTip="Recent Queries">
                    <StackPanel Orientation="Horizontal">
                        <!-- 小さめの灰色 -->
                        <Path Data="{StaticResource Icon.Search}" Stroke="{DynamicResource Gk.Text.Dim}" StrokeThickness="1.3" Width="11" Height="11" Stretch="Uniform"/>
                        <Path Data="{StaticResource Icon.ChevronDown}" Stroke="{DynamicResource Gk.Text.Dim}" StrokeThickness="1.2" Width="7" Height="7" Stretch="Uniform" Margin="2,2,0,0"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.AutomationId="PART_ClearButton" HorizontalAlignment="Right" Width="16" Height="16" Margin="0,0,3,0" Padding="0"
                        Focusable="False" Click="ClearSearch_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Gk.FlatButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Data="M4,4 L12,12 M12,4 L4,12" Stroke="{DynamicResource Gk.Text.Dim}" StrokeThickness="1.3" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
            </Grid>
            <Grid Grid.Row="2" Margin="6,0,8,3">
                <Button AutomationProperties.AutomationId="SearchDropdownButton" Style="{StaticResource Gk.FlatButton}" HorizontalAlignment="Left" Padding="4,1" Click="SearchMode_Click"
                        AutomationProperties.Name="{Binding TypeLabel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center"/>
                        <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource Gk.IconPath}" Width="9" Height="9" Stretch="Uniform" Margin="5,1,0,0"/>
                    </StackPanel>
                </Button>
                <TextBlock AutomationProperties.AutomationId="FoundCommitsTextBlock" Text="{Binding ResultText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Gk.Text.Dim}"/>
            </Grid>
            <ListBox Grid.Row="3" x:Name="SearchResults" AutomationProperties.AutomationId="TreeView" Style="{StaticResource Gk.ListBox}" ItemContainerStyle="{StaticResource Gk.SidebarRow}"
                     ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SearchRow}">
                        <Grid Height="22" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="Expander" AutomationProperties.AutomationId="ExpandCollapseToggleButton" Width="16" Focusable="False" IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                          Click="SearchExpander_Click" Visibility="Collapsed" Foreground="{DynamicResource Gk.Text.Dim}" Margin="2,0,2,0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Path x:Name="Chevron" Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.ChevronDown}" Width="11" Height="11" Stretch="Uniform"/>
                            </ToggleButton>
                            <c:Avatar x:Name="Avatar" Grid.Column="1" Width="14" Height="14" NameText="{Binding AuthorName}" Email="{Binding AuthorEmail}" Margin="6,0,8,0"
                                      AutomationProperties.AutomationId="AuthorAvatarImage"/>
                            <TextBlock x:Name="Subject" Grid.Column="2" AutomationProperties.AutomationId="RevisionSubjectTextBlock" local:Highlight.Text="{Binding Subject}" local:Highlight.Term="{Binding HighlightTerm}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="Date" Grid.Column="3" AutomationProperties.AutomationId="AuthorDateTextBlock" Text="{Binding DateText}" VerticalAlignment="Center" Margin="6,0,6,0"
                                       Foreground="{DynamicResource Gk.Text.Dim}"/>
                            <StackPanel x:Name="FileLine" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Visibility="Collapsed" Margin="22,0,0,0">
                                <Border Style="{StaticResource Gk.ChangeBadge}" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding ChangeLetter}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                </Border>
                                <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.File}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"/>
                                <TextBlock AutomationProperties.AutomationId="FilePathTextBlock" Text="{Binding FilePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding HasFiles}" Value="True">
                                <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                <Setter TargetName="Chevron" Property="Data" Value="{StaticResource Icon.ChevronRight}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFile}" Value="True">
                                <Setter TargetName="Avatar" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Subject" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Date" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="FileLine" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        </UserControl>

        <!-- フィルタ -->
        <Grid Grid.Row="3" Margin="6,2,6,6" Visibility="{Binding Visibility, ElementName=Tree}">
            <TextBox x:Name="FilterBox" AutomationProperties.AutomationId="FilterTextBox" Style="{StaticResource Gk.TextBox}" Height="22" Padding="20,0,4,0"
                     Text="{Binding Sidebar.FilterText, UpdateSourceTrigger=PropertyChanged}"/>
            <Path Data="{StaticResource Icon.Search}" Stroke="{DynamicResource Gk.Text.Faint}" StrokeThickness="1.2" Width="16" Height="16" HorizontalAlignment="Left" Margin="4,0,0,0" IsHitTestVisible="False"
                  RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><ScaleTransform ScaleX="0.75" ScaleY="0.75"/></Path.RenderTransform>
            </Path>
            <TextBlock Text="Filter" Foreground="{DynamicResource Gk.Text.Faint}" Margin="22,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 参照ツリー（1 本のリストに平らに並べる） -->
        <ListBox Grid.Row="4" x:Name="Tree" AutomationProperties.AutomationId="SidebarTreeView" Style="{StaticResource Gk.ListBox}" Visibility="{Binding SidebarTab, Converter={StaticResource Gk.EnumToCollapsed}, ConverterParameter=Branches}"
                 ItemsSource="{Binding Sidebar.Rows}" SelectedItem="{Binding Sidebar.SelectedItem}" ItemContainerStyle="{StaticResource Gk.SidebarRow}" SelectionMode="Extended"
                 MouseDoubleClick="Tree_MouseDoubleClick" PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp" ContextMenuOpening="Tree_ContextMenuOpening" KeyDown="Tree_KeyDown" SelectionChanged="Tree_SelectionChanged">
            <ListBox.ContextMenu>
                <ContextMenu/>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:SidebarItem}">
                    <Grid Height="22" Margin="{Binding Level, Converter={StaticResource Gk.LevelToIndent}}" ToolTip="{Binding ToolTipText}" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- ToggleButton にして開閉状態を UIA から読めるようにする。開閉は Expander_MouseDown で行う -->
                        <ToggleButton x:Name="Expander" AutomationProperties.AutomationId="ExpandCollapseToggleButton" Grid.Column="0" Focusable="False"
                                      IsChecked="{Binding IsExpanded, Mode=OneWay}" PreviewMouseLeftButtonDown="Expander_MouseDown" Visibility="Hidden" Foreground="{DynamicResource Gk.Text.Dim}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Path x:Name="Chevron" Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.ChevronDown}" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform><ScaleTransform ScaleX="0.7" ScaleY="0.7"/></Path.RenderTransform>
                            </Path>
                        </ToggleButton>
                        <c:IconImage x:Name="Icon" Grid.Column="1" Geometry="{Binding Converter={StaticResource Gk.SidebarIcon}}" AutomationProperties.AutomationId="{Binding ImageId}"
                                     Width="18" Height="18" Margin="0,-1,3,-1" VerticalAlignment="Center"/>
                        <!-- アイコンは 18px（アイコンは 16 の枠に余白があるので 1.125 倍にして、フォルダやタグが枠いっぱいに見えるようにする） -->
                        <!-- upstream が消えたブランチ（[gone]）はアイコンの右下に黄色い三角 -->
                        <Path Grid.Column="1" Data="M4,0 L8,7 L0,7 Z M4,2.6 L4,4.6 M4,5.6 L4,6" Fill="#F2C230" Stroke="#202020" StrokeThickness="0.6"
                              Width="8" Height="7" Stretch="None" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,3" IsHitTestVisible="False">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Reference.UpstreamGone}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock x:Name="Title" AutomationProperties.AutomationId="TitleTextBlock" Grid.Column="2" Text="{Binding DisplayTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="Track" Grid.Column="3" Text="{Binding TrackText}" VerticalAlignment="Center" Margin="4,0,8,0" Foreground="{DynamicResource Gk.Text}"/>
                        <!-- ホバーで出る Filter / Hide（付けているあいだは出したままでアクセント色）。ahead / behind の数と重ならないよう右に別の列 -->
                        <StackPanel x:Name="HoverButtons" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed">
                            <Button x:Name="PinButton" AutomationProperties.AutomationId="PinButton" Width="16" Height="16" Padding="0" Focusable="False"
                                    ToolTip="Pin" Click="PinButton_Click">
                                <!-- Visibility は Style で（隠しているときに DataTemplate のトリガーで消せるように） -->
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Gk.FlatButton}">
                                        <Setter Property="Visibility" Value="{Binding CanPin, Converter={StaticResource Gk.BoolToVisibility}}"/>
                                    </Style>
                                </Button.Style>
                                <c:IconImage x:Name="PinIcon" Geometry="{StaticResource Icon.Pin}" Width="12" Height="12"/>
                            </Button>
                            <Button x:Name="FilterButton" AutomationProperties.AutomationId="FilterButton" Style="{StaticResource Gk.FlatButton}" Width="16" Height="16" Padding="0" Focusable="False"
                                    ToolTip="{Binding FilterToolTip}" Click="FilterButton_Click">
                                <c:IconImage x:Name="FilterIcon" AutomationProperties.AutomationId="FilterButtonImage" Geometry="{StaticResource Icon.Filter}" Width="12" Height="12"/>
                            </Button>
                            <Button AutomationProperties.AutomationId="HideButton" Style="{StaticResource Gk.FlatButton}" Width="16" Height="16" Padding="0" Focusable="False"
                                    ToolTip="{Binding HideToolTip}" Click="HideButton_Click">
                                <c:IconImage x:Name="HideIcon" AutomationProperties.AutomationId="HideButtonImage" Geometry="{StaticResource Icon.Eye}" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding ShowExpander}" Value="True">
                            <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <!-- "Show all tags (39)"：タグの名前と同じ位置にリンクの色で -->
                        <DataTrigger Binding="{Binding Kind}" Value="ShowMore">
                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Gk.Accent}"/>
                            <Setter TargetName="Title" Property="Cursor" Value="Hand"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                            <Setter TargetName="Chevron" Property="Data" Value="{StaticResource Icon.ChevronRight}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Group">
                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Title" Property="FontSize" Value="12.5"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrentBranch}" Value="True">
                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasChildren}" Value="False">
                            <Setter TargetName="Expander" Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding CanFilter}" Value="True"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HoverButtons" Property="Visibility" Value="Visible"/><Setter TargetName="Track" Property="Margin" Value="4,0,2,0"/>
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                            <Setter TargetName="PinIcon" Property="Stroke" Value="{DynamicResource Gk.Accent}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFilterActive}" Value="True">
                            <Setter TargetName="HoverButtons" Property="Visibility" Value="Visible"/><Setter TargetName="Track" Property="Margin" Value="4,0,2,0"/>
                            <Setter TargetName="FilterIcon" Property="Stroke" Value="{DynamicResource Gk.Accent}"/>
                        </DataTrigger>
                        <!-- 隠しているあいだは斜線の入った目を大きめに出したまま（ホバーしていなければ Pin / Filter は出さない） -->
                        <DataTrigger Binding="{Binding IsHiddenActive}" Value="True">
                            <Setter TargetName="HoverButtons" Property="Visibility" Value="Visible"/><Setter TargetName="Track" Property="Margin" Value="4,0,2,0"/>
                            <Setter TargetName="HideIcon" Property="Stroke" Value="{DynamicResource Gk.Accent}"/>
                            <Setter TargetName="HideIcon" Property="Geometry" Value="{StaticResource Icon.EyeOff}"/>
                            <Setter TargetName="HideIcon" Property="Width" Value="16"/>
                            <Setter TargetName="HideIcon" Property="Height" Value="16"/>
                            <Setter TargetName="Title" Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsHiddenActive}" Value="True"/>
                                <Condition Binding="{Binding IsFilterActive}" Value="False"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="FilterButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PinButton" Property="Visibility" Value="Collapsed"/>
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
