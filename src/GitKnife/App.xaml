<Application x:Class="GitKnife.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GitKnife"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] はテーマ。ThemeManager が Dark / Light を差し替える -->
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Themes/CustomControls.xaml"/>
                <ResourceDictionary Source="Themes/FileList.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:PositiveToVisibilityConverter x:Key="Gk.PositiveToVisibility"/>
            <local:BoolToVisibilityConverter x:Key="Gk.BoolToVisibility"/>
            <local:NotEmptyToVisibilityConverter x:Key="Gk.NotEmptyToVisibility"/>
            <local:EnumEqualsConverter x:Key="Gk.EnumEquals"/>
            <local:EnumToCollapsedConverter x:Key="Gk.EnumToCollapsed"/>
            <local:LevelToIndentConverter x:Key="Gk.LevelToIndent"/>
            <local:GraphWidthConverter x:Key="Gk.GraphWidth"/>
            <local:RefLabelBrushConverter x:Key="Gk.RefLabelBrush"/>
            <local:RefLabelIconConverter x:Key="Gk.RefLabelIcon"/>
            <local:SidebarIconConverter x:Key="Gk.SidebarIcon"/>
            <local:EmptyToVisibilityConverter x:Key="Gk.EmptyToVisibility"/>
            <local:FileIndentConverter x:Key="Gk.FileIndent"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
