<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:GitKnife"
                    xmlns:vm="clr-namespace:GitKnife.ViewModels"
                    xmlns:c="clr-namespace:GitKnife.Controls">
    <!--
      ファイル一覧（Local Changes の 2 リスト、コミット詳細の Changes / File Tree）。ListView + GridView なので行は UIA の DataItem。
      フォルダの開閉は ListView の DataContext の ToggleFolderCommand（引数は FileListItem）。
    -->
    <!-- ファイル行の状態アイコン（色付きの四角に文字） -->
    <!-- 変化の印：14px の四角に白い文字（+ #28CD41、M #FFCC00） -->
    <Style x:Key="Gk.ChangeBadge" TargetType="Border">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource Gk.Change.Modified}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding ChangeLetter}" Value="+"><Setter Property="Background" Value="{DynamicResource Gk.Change.Added}"/></DataTrigger>
            <DataTrigger Binding="{Binding ChangeLetter}" Value="−"><Setter Property="Background" Value="{DynamicResource Gk.Change.Deleted}"/></DataTrigger>
            <DataTrigger Binding="{Binding ChangeLetter}" Value="R"><Setter Property="Background" Value="{DynamicResource Gk.Change.Renamed}"/></DataTrigger>
            <DataTrigger Binding="{Binding ChangeLetter}" Value="!"><Setter Property="Background" Value="{DynamicResource Gk.Change.Conflicted}"/></DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Gk.FileRowTemplate" DataType="{x:Type vm:FileListItem}">
        <Grid Height="20" Margin="{Binding Level, Converter={x:Static local:FileIndentConverter.Instance}}" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="Expander" Style="{StaticResource Gk.FlatButton}" Padding="0" Visibility="Hidden" Foreground="{DynamicResource Gk.Text.Dim}" Command="{Binding DataContext.ToggleFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Focusable="False">
                <Path x:Name="Chevron" Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12" Stretch="Uniform"/>
            </Button>
            <Border x:Name="Badge" Grid.Column="1" Style="{StaticResource Gk.ChangeBadge}" Margin="2,0,4,0">
                <TextBlock Text="{Binding ChangeLetter}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
            </Border>
            <!-- 競合は黄色い三角に "!" -->
            <Path x:Name="ConflictIcon" Grid.Column="1" Data="M7,1 L13.5,12.5 L0.5,12.5 Z M7,4.5 L7,8.5 M7,10 L7,10.8" Fill="#F2C230" Stroke="#202020" StrokeThickness="1.2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="None" Margin="2,0,4,0" VerticalAlignment="Center" Visibility="Collapsed"/>
            <Path x:Name="TypeIcon" Grid.Column="2" Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.File}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,4,0" Visibility="Collapsed"/>
            <!-- ファイルは Windows がその拡張子に出すアイコン（OS のアイコン） -->
            <Image x:Name="ShellIcon" Grid.Column="2" Source="{Binding Path, Converter={x:Static c:ShellIconConverter.Instance}}" Width="16" Height="16" Margin="0,0,4,0"
                   RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ChangeLetter}" Value="!">
                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ConflictIcon" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                <Setter TargetName="Expander" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ShellIcon" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="TypeIcon" Property="Visibility" Value="Visible"/>
                <Setter TargetName="TypeIcon" Property="Data" Value="{StaticResource Icon.Folder}"/>
                <Setter TargetName="TypeIcon" Property="Fill" Value="{DynamicResource Gk.Change.Modified}"/>
                <Setter TargetName="TypeIcon" Property="Stroke" Value="{DynamicResource Gk.Change.Modified}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding HasChange}" Value="False">
                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                <Setter TargetName="Chevron" Property="Data" Value="{StaticResource Icon.ChevronRight}"/>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="Gk.FileListViewItem" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Gk.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" SnapsToDevicePixels="True">
                        <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Gk.List.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Gk.Selection.Inactive}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="Selector.IsSelectionActive" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Gk.Selection}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Gk.Text.OnSelection}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Gk.FileListView" TargetType="ListView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Gk.Text}"/>
        <Setter Property="Padding" Value="0,3"/>
        <Setter Property="SelectionMode" Value="Extended"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Gk.FileListViewItem}"/>
        <Setter Property="AutomationProperties.AutomationId" Value="TreeView"/>
        <!-- 行は見えている分だけ作る（1 万行を超える一覧がある）。スクロールはピクセル単位のまま -->
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False" CanContentScroll="True">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- 競合の案内のカード（ブランチ名、"modified"、そのファイルを変えたコミット） -->
    <DataTemplate x:Key="Gk.ConflictCommitRow">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <c:Avatar Width="16" Height="16" NameText="{Binding AuthorName}" Email="{Binding AuthorEmail}" Margin="0,0,6,0"/>
            <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                <Run Text="{Binding ShortSha, Mode=OneWay}" Foreground="{DynamicResource Gk.Text.Dim}"/> <Run Text="{Binding Subject, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Grid.Column="2" Text="{Binding Time, StringFormat='d MMM yyyy', ConverterCulture=en-US}" Foreground="{DynamicResource Gk.Text.Dim}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="Gk.ConflictCardTheirs">
        <Border BorderBrush="{DynamicResource Gk.Accent}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource Gk.Details.Background}" Padding="14,10" MinWidth="300">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Branch}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TheirsName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock AutomationProperties.AutomationId="RemoteChangeTypeTextBlock" Text="modified" HorizontalAlignment="Right" Foreground="{DynamicResource Gk.Text.Dim}" FontSize="11.5" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Gk.Splitter}" Margin="0,8"/>
                <ItemsControl AutomationProperties.AutomationId="SrcRevisionsListBox" ItemsSource="{Binding Theirs}" ItemTemplate="{StaticResource Gk.ConflictCommitRow}"/>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="Gk.ConflictCardOurs">
        <Border BorderBrush="{DynamicResource Gk.Accent}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource Gk.Details.Background}" Padding="14,10" MinWidth="300">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource Gk.IconPath}" Data="{StaticResource Icon.Branch}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding OursName}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock AutomationProperties.AutomationId="LocalChangeTypeTextBlock" Text="modified" HorizontalAlignment="Right" Foreground="{DynamicResource Gk.Text.Dim}" FontSize="11.5" VerticalAlignment="Center"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource Gk.Splitter}" Margin="0,8"/>
                <ItemsControl AutomationProperties.AutomationId="DstRevisionsListBox" ItemsSource="{Binding Ours}" ItemTemplate="{StaticResource Gk.ConflictCommitRow}"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
