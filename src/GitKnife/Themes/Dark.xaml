<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      ダークテーマの色。
      キー名は Light.xaml と同じ。ThemeManager がこの辞書ごと差し替える。
    -->
    <Color x:Key="Gk.AccentColor">#61CCFF</Color>
    <SolidColorBrush x:Key="Gk.Accent" Color="#61CCFF"/>
    <SolidColorBrush x:Key="Gk.Link" Color="#4FA8F0"/>

    <SolidColorBrush x:Key="Gk.Window.Background" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Gk.TitleBar.Background" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Gk.Toolbar.Background" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Gk.StatusBox.Background" Color="#303030"/>
    <SolidColorBrush x:Key="Gk.TabBar.Background" Color="#101010"/>
    <SolidColorBrush x:Key="Gk.Tab.Active" Color="#2C2C2D"/>
    <SolidColorBrush x:Key="Gk.Tab.Hover" Color="#1E1E1E"/>

    <SolidColorBrush x:Key="Gk.Sidebar.Background" Color="#2C2C2D"/>
    <SolidColorBrush x:Key="Gk.Sidebar.Selected" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="Gk.Input.Background" Color="#292929"/>
    <!-- Custom Commands の右の面（一覧より明るい） -->
    <SolidColorBrush x:Key="Gk.Panel.Background" Color="#333333"/>
    <SolidColorBrush x:Key="Gk.Input.Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Gk.Border" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="Gk.Splitter" Color="#525252"/>

    <SolidColorBrush x:Key="Gk.List.Background" Color="#212121"/>
    <SolidColorBrush x:Key="Gk.List.Hover" Color="#2A2A2A"/>
    <!-- サイドバーの上の 2 つのアイコン（ブランチの木 / 検索）のホバー（サイドバーの地 #2C2C2D より暗い） -->
    <SolidColorBrush x:Key="Gk.IconRadio.Hover" Color="#242424"/>
    <SolidColorBrush x:Key="Gk.Selection" Color="#236BD2"/>
    <SolidColorBrush x:Key="Gk.Selection.Inactive" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="Gk.CommitList.Selection.Inactive" Color="#525252"/>
    <SolidColorBrush x:Key="Gk.ImageFrame" Color="#4B4B4B"/>
    <SolidColorBrush x:Key="Gk.Details.Background" Color="#333333"/>
    <!-- Repository Manager（左の木 #2C2C2D、右の地 #202020、枠は地より少し明るい #2D2D2D） -->
    <SolidColorBrush x:Key="Gk.Manager.Tree" Color="#2C2C2D"/>
    <SolidColorBrush x:Key="Gk.Manager.Background" Color="#202020"/>
    <SolidColorBrush x:Key="Gk.Manager.Card" Color="#2D2D2D"/>
    <!-- アイコン付きのダイアログ（Create Branch など）の中だけの色：背景、入力欄とボタンの枠、入力欄の地 -->
    <!-- チェックボックスの印と、ラジオボタンの外れの輪 -->
    <SolidColorBrush x:Key="Gk.OnAccent" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Gk.Radio.Border" Color="#646464"/>
    <!-- 枠つきの一覧（PreferencesView.FramedList） -->
    <SolidColorBrush x:Key="Gk.FramedList.Background" Color="#212121"/>
    <SolidColorBrush x:Key="Gk.FramedList.Footer" Color="#333333"/>
    <SolidColorBrush x:Key="Gk.FramedList.Button" Color="#373737"/>
    <SolidColorBrush x:Key="Gk.FramedList.Icon" Color="#CFCFCF"/>
    <!-- Interactive Rebase：Squash / Fixup の点、squash の線と矢印、動作の欄のホバー、Move Up / Down の矢印、Reword の 72 桁の線 -->
    <SolidColorBrush x:Key="Gk.Rebase.Squash" Color="#E1E1E1"/>
    <SolidColorBrush x:Key="Gk.Rebase.Graph" Color="#CAC6C6"/>
    <SolidColorBrush x:Key="Gk.Rebase.ActionHover" Color="#303030"/>
    <SolidColorBrush x:Key="Gk.Rebase.MoveArrow" Color="#1B9192"/>
    <SolidColorBrush x:Key="Gk.Rebase.Ruler" Color="#444444"/>
    <SolidColorBrush x:Key="Gk.Rebase.Popup" Color="#1B1B1C"/>
    <SolidColorBrush x:Key="Gk.Rebase.PopupHover" Color="#424242"/>
    <!-- History / Blame の窓の地と一覧 -->
    <SolidColorBrush x:Key="Gk.ToolWindow.Background" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="Gk.ToolWindow.List" Color="#212121"/>
    <SolidColorBrush x:Key="Gk.Dialog.Background" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Gk.Dialog.Input.Border" Color="#525252"/>
    <SolidColorBrush x:Key="Gk.Dialog.Input.Background" Color="#333333"/>
    <SolidColorBrush x:Key="Gk.Header.Background" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Gk.Button.Background" Color="#373737"/>
    <SolidColorBrush x:Key="Gk.Button.Hover" Color="#454545"/>
    <SolidColorBrush x:Key="Gk.Button.Pressed" Color="#505050"/>
    <SolidColorBrush x:Key="Gk.Menu.Background" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Gk.Menu.Hover" Color="#3F3F3F"/>

    <SolidColorBrush x:Key="Gk.Text" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Gk.Text.Strong" Color="#FFFFFF"/>
    <!-- アイコンの線（サイドバー、ツールバー。文字より少し薄い） -->
    <SolidColorBrush x:Key="Gk.Icon" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="Gk.Text.Dim" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Gk.Text.Faint" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="Gk.Text.OnSelection" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Gk.Diff.Background" Color="#282828"/>
    <SolidColorBrush x:Key="Gk.Diff.Added" Color="#3A5C3F"/>
    <SolidColorBrush x:Key="Gk.Diff.AddedInline" Color="#4E8A55"/>
    <SolidColorBrush x:Key="Gk.Diff.Removed" Color="#5E3A3A"/>
    <SolidColorBrush x:Key="Gk.Diff.RemovedInline" Color="#8F4A4A"/>
    <SolidColorBrush x:Key="Gk.Diff.Hunk" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Gk.Merge.Theirs" Color="#5A5578"/>
    <SolidColorBrush x:Key="Gk.Merge.Ours" Color="#2C5466"/>
    <SolidColorBrush x:Key="Gk.Merge.Unresolved" Color="#A23F3F"/>
    <SolidColorBrush x:Key="Gk.Diff.Filler" Color="#383838"/>
    <SolidColorBrush x:Key="Gk.Diff.SelectionBorder" Color="#4A86E8"/>
    <SolidColorBrush x:Key="Gk.Diff.SelectionFill" Color="#1F4A86E8"/>
    <SolidColorBrush x:Key="Gk.Diff.TextSelection" Color="#55236BD2"/>

    <SolidColorBrush x:Key="Gk.Label.Tag" Color="#3E3F4E"/>
    <SolidColorBrush x:Key="Gk.Label.Stash" Color="#545454"/>
    <SolidColorBrush x:Key="Gk.Label.TagBorder" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Gk.Label.StashBorder" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Gk.Label.Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Gk.Label.Border" Color="#8A8A8A"/>

    <!-- 変化の色（追加 #28CD41、変更 #FFCC00 は Dark と Light で同じ。削除と名前変更は同じ系統の色） -->
    <SolidColorBrush x:Key="Gk.Change.Added" Color="#28CD41"/>
    <SolidColorBrush x:Key="Gk.Change.Modified" Color="#FFCC00"/>
    <SolidColorBrush x:Key="Gk.Change.Deleted" Color="#FF3B30"/>
    <SolidColorBrush x:Key="Gk.Change.Renamed" Color="#007AFF"/>
    <SolidColorBrush x:Key="Gk.Change.Conflicted" Color="#FF6B3D"/>
</ResourceDictionary>
