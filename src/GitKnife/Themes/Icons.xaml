    <!-- 黄色い警告の三角（Delete Branch の WorktreeWarningImage、Git Error のアイコンの右下） -->
    <DrawingImage x:Key="Gk.WarningImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F5C518" Geometry="M11,1 L21.5,19 L0.5,19 Z"><GeometryDrawing.Pen><Pen Brush="#2B2B2B" Thickness="1" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Geometry="M11,7 L11,12.5 M11,15.2 L11,15.4"><GeometryDrawing.Pen><Pen Brush="#1A1A1A" Thickness="2.2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Gk.AppIcon">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- 64×64 の枠（丸は 1〜63 なので、無いと Image が少し拡大する） -->
                <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,64,64"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><EllipseGeometry Center="32,32" RadiusX="31" RadiusY="31"/></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#42B6EC"><GeometryDrawing.Geometry><EllipseGeometry Center="32,32" RadiusX="28" RadiusY="28"/></GeometryDrawing.Geometry></GeometryDrawing>
                <DrawingGroup>
                    <DrawingGroup.ClipGeometry><EllipseGeometry Center="32,32" RadiusX="28" RadiusY="28"/></DrawingGroup.ClipGeometry>
                    <GeometryDrawing Brush="White" Geometry="{StaticResource Icon.AppKnife}"/>
                    <GeometryDrawing Brush="#CEE9F8" Geometry="{StaticResource Icon.AppKnifeBevel}"/>
                </DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
