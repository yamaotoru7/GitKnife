<Project Sdk="Microsoft.NET.Sdk">

  <!--
    GIT_ASKPASS／credential helper／SSH_ASKPASS として git から起動される小さな exe。
    本体（GitKnife.exe）と名前付きパイプで通信して、パスワード・パスフレーズ・既知ホスト確認を仲介する。
    起動が速いことが大事なので依存を増やさない。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GitKnife.AskPass</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
