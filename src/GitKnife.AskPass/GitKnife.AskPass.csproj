<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SSH_ASKPASS として ssh から起動される小さな exe。
    本体（GitKnife.exe）と名前付きパイプで通信して、パスワード・パスフレーズ・既知ホスト確認を仲介する。
    起動が速いことが大事なので、依存は GitKnife.Core（パッケージ参照なし）だけ。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GitKnife.AskPass</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitKnife.Core\GitKnife.Core.csproj" />
  </ItemGroup>

</Project>
