<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>GitKnife.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GitKnife.Core\GitKnife.Core.csproj" />
    <!-- Interactive Rebase の通しのテストで GitKnife.RI.exe を git に起動させる -->
    <ProjectReference Include="..\..\src\GitKnife.RI\GitKnife.RI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- テスト用リポジトリの組み立て -->
    <Compile Include="..\..\tools\Shared\SandboxBuilder.cs" Link="Shared\SandboxBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- テスト用のデータファイル（書式の比較用） -->
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
